NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — never expose these with the NEXT_PUBLIC_ prefix.
# Service role key bypasses RLS; used server-side only (lib/serverAuth.js).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by app/api/ask-ai/route.js (Community Assistant)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Used by app/api/translate/route.js (post/comment translation)
DEEPL_API_KEY=your-deepl-api-key

# Used by notify-*/route.js and inbound-email/route.js (outgoing email + reply-by-email)
RESEND_API_KEY=your-resend-api-key
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# --- White-label branding (see lib/brandConfig.js) ---
# All optional - each falls back to the current Mi Hacienda values if unset.
# Set these when provisioning a NEW community deployment.
NEXT_PUBLIC_COMMUNITY_NAME=Mi Hacienda
NEXT_PUBLIC_COMMUNITY_FULL_NAME=Hacienda del Señorío de Cifuentes
NEXT_PUBLIC_COMMUNITY_ADDRESS=Calle Torre Campanillas 7, Benahavís 29679, España
EMAIL_FROM_ADDRESS=noreply@myhumandesign.sk
NEXT_PUBLIC_HERO_IMAGE_PATH=/images/hero-entrance-sign.jpg
NEXT_PUBLIC_HERO_IMAGE_ALT=Hacienda del Señorío de Cifuentes entrance

# Optional brand colors (hex). Falls back to the current dark-blue/sand/ochre theme if unset.
NEXT_PUBLIC_BRAND_COLOR_PRIMARY=#143B4D
NEXT_PUBLIC_BRAND_COLOR_BACKGROUND=#F4EFE6
NEXT_PUBLIC_BRAND_COLOR_ACCENT=#C98A2E
